<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include metadata.liquid %}
    <link rel="icon" type="image/jpeg" href="{{ '/assets/img/plat.jpg' | relative_url }}">
    <link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
    <link rel="alternate" type="application/atom+xml" title="Elijah Soba’s Logbook" href="{{ '/feed.xml' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/logbook.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/jekyll-pygments-themes-github.css' | relative_url }}">
    {% if page.redirect %}<meta http-equiv="refresh" content="0; url={{ page.redirect | relative_url }}">{% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {% include header.liquid %}
    <main id="main" class="shell">{{ content }}</main>
    <footer class="shell site-footer">
      <span>Elijah Soba <span aria-hidden="true">/</span> Logbook</span>
      <div>
        <a href="{{ '/feed.xml' | relative_url }}">RSS</a><a href="https://github.com/esoba">GitHub</a
        ><a href="https://github.com/alshedivat/al-folio">Built with al-folio</a>
      </div>
    </footer>
    <script src="{{ '/assets/js/logbook.js' | relative_url }}" defer></script>
    {% if page.math and site.plugins contains 'al_math' %}{% include plugins/al_math_scripts.liquid %}{% endif %}
  </body>
</html>
