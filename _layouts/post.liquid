---
layout: default
---
<article>
  <header class="intro compact post-heading">
    <a class="back-link" href="{{ '/' | relative_url }}">← Logbook</a>
    <p class="eyebrow">
      <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%B %d, %Y' }}</time> /
      {{ page.content | strip_html | number_of_words | divided_by: 180 | plus: 1 }} min read
    </p>
    <h1>{{ page.title | escape }}</h1>
    <p class="lede">{{ page.description | escape }}</p>
    <div class="tags">
      {% for tag in page.tags -%}
        <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">{{ tag | escape }}</a>
      {%- endfor %}
    </div>
  </header>
  <div class="prose">{{ content }}</div>
</article>
