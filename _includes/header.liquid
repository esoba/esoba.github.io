<header class="site-header shell">
  <a class="site-brand" href="{{ '/' | relative_url }}"
    ><img src="{{ '/assets/img/plat.jpg' | relative_url }}" alt="" width="36" height="36"
    ><span>Elijah Soba<span class="brand-label">Notes from the workbench</span></span></a
  >
  <nav aria-label="Main navigation">
    <a
      href="{{ '/' | relative_url }}"
      {% if page.section == 'logbook' or page.type or page.pagination %}
        aria-current="page"
      {% endif %}
      >Logbook</a
    >
    <a
      href="{{ '/resources/' | relative_url }}"
      {% if page.section == 'resources' %}
        aria-current="page"
      {% endif %}
      >Resources</a
    >
    <a
      href="{{ '/about/' | relative_url }}"
      {% if page.section == 'about' %}
        aria-current="page"
      {% endif %}
      >About</a
    >
    {% if site.enable_darkmode %}
      <button id="light-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode" hidden>
        <svg
          class="theme-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20.9 13.2A9 9 0 0 1 10.8 3.1a9 9 0 1 0 10.1 10.1Z"></path>
        </svg>
        <svg
          class="theme-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    {% endif %}
  </nav>
</header>
